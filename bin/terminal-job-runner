#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawn } = require("node:child_process");
const {
  ARTIFACT_SCHEMA_VERSION,
  launchFields,
  outcomeFields,
} = require("./terminal-job-schema.cjs");

function fail(message) {
  process.stderr.write(`terminal-job-runner: ${message}\n`);
  process.exit(64);
}

function parseArgs(argv) {
  const values = new Map();
  let index = 0;
  while (index < argv.length && argv[index] !== "--") {
    const name = argv[index++];
    if (!["--job-id", "--owner-thread", "--artifact-root"].includes(name)) {
      fail(`unknown option: ${name}`);
    }
    if (index >= argv.length) fail(`missing value for ${name}`);
    if (values.has(name)) fail(`duplicate option: ${name}`);
    values.set(name, argv[index++]);
  }
  if (argv[index] !== "--") fail("command arguments must follow --");
  const command = argv.slice(index + 1);
  if (command.length === 0) fail("missing command after --");
  for (const name of ["--job-id", "--owner-thread", "--artifact-root"]) {
    if (!values.has(name)) fail(`missing ${name}`);
  }
  return {
    jobId: values.get("--job-id"),
    ownerThreadId: values.get("--owner-thread"),
    artifactRoot: values.get("--artifact-root"),
    argv: command,
  };
}

function assertSafeMarker(name, value) {
  if (!value || value.length > 512 || /[\0-\x1f\x7f]/u.test(value)) fail(`invalid ${name}`);
}

function writeAll(fd, buffer) {
  let offset = 0;
  while (offset < buffer.length) offset += fs.writeSync(fd, buffer, offset);
}

function atomicJson(filePath, value, fields) {
  const keys = Object.keys(value);
  if (keys.length !== fields.length || fields.some((field) => !keys.includes(field))) {
    throw new Error(`internal artifact schema mismatch for ${path.basename(filePath)}`);
  }
  const temporary = `${filePath}.tmp-${process.pid}-${Date.now()}`;
  const fd = fs.openSync(temporary, "wx", 0o600);
  try {
    writeAll(fd, Buffer.from(`${JSON.stringify(value)}\n`, "utf8"));
    fs.fsyncSync(fd);
  } finally {
    fs.closeSync(fd);
  }
  fs.renameSync(temporary, filePath);
  const directoryFd = fs.openSync(path.dirname(filePath), "r");
  try {
    fs.fsyncSync(directoryFd);
  } finally {
    fs.closeSync(directoryFd);
  }
}

const signalNumbers = os.constants.signals;

async function main() {
  const args = parseArgs(process.argv.slice(2));
  assertSafeMarker("job ID", args.jobId);
  if (!/^job_[A-Za-z0-9_-]+$/u.test(args.jobId)) fail("invalid job ID");
  assertSafeMarker("owner thread", args.ownerThreadId);
  if (
    args.artifactRoot.length > 4096 ||
    !path.posix.isAbsolute(args.artifactRoot) ||
    /[\0-\x1f\x7f]/u.test(args.artifactRoot)
  ) {
    fail("--artifact-root must be an absolute POSIX path");
  }

  const jobDirectory = path.posix.join(args.artifactRoot, args.jobId);
  const launchPath = path.posix.join(jobDirectory, "launch.json");
  const logPath = path.posix.join(jobDirectory, "output.log");
  const outcomePath = path.posix.join(jobDirectory, "outcome.json");
  fs.mkdirSync(jobDirectory, { recursive: true, mode: 0o700 });
  fs.chmodSync(jobDirectory, 0o700);
  const startedMs = Date.now();
  const startedAt = new Date(startedMs).toISOString();
  const terminalId = process.env.BB_TERMINAL_SESSION_ID || null;

  atomicJson(
    launchPath,
    {
      schemaVersion: ARTIFACT_SCHEMA_VERSION,
      jobId: args.jobId,
      terminalId,
      ownerThreadId: args.ownerThreadId,
      argv: args.argv,
      startedAt,
      artifactRoot: args.artifactRoot,
      jobDirectory,
      launchPath,
      logPath,
      outcomePath,
    },
    launchFields,
  );
  const logFd = fs.openSync(logPath, "a", 0o600);
  fs.fchmodSync(logFd, 0o600);

  let child;
  let launchError = null;
  try {
    child = spawn("/bin/sh", ["-c", 'exec "$@" 2>&1', "terminal-job-child", ...args.argv], {
      stdio: ["ignore", "pipe", "inherit"],
      env: process.env,
    });
  } catch (error) {
    launchError = error;
  }

  if (!child) {
    const text = Buffer.from(`terminal-job-runner: launch failed: ${String(launchError)}\n`);
    writeAll(logFd, text);
    process.stdout.write(text);
    fs.fsyncSync(logFd);
    fs.closeSync(logFd);
    const finishedMs = Date.now();
    atomicJson(
      outcomePath,
      {
        schemaVersion: ARTIFACT_SCHEMA_VERSION,
        jobId: args.jobId,
        terminalId,
        ownerThreadId: args.ownerThreadId,
        commandExitCode: null,
        signal: null,
        status: 127,
        result: "launch-failed",
        startedAt,
        finishedAt: new Date(finishedMs).toISOString(),
        durationMs: finishedMs - startedMs,
        logPath,
      },
      outcomeFields,
    );
    process.exitCode = 127;
    return;
  }

  let spawnError = null;
  child.once("error", (error) => {
    spawnError = error;
  });
  child.stdout.on("data", (chunk) => {
    writeAll(logFd, chunk);
    process.stdout.write(chunk);
  });

  let forwardedSignal = null;
  const forward = (signal) => {
    forwardedSignal = signal;
    if (child.exitCode === null && child.signalCode === null) child.kill(signal);
  };
  for (const signal of ["SIGHUP", "SIGINT", "SIGTERM"]) {
    process.on(signal, () => forward(signal));
  }

  const settled = await new Promise((resolve) => {
    child.once("close", (code, signal) => resolve({ code, signal }));
  });
  if (spawnError) {
    const text = Buffer.from(`terminal-job-runner: launch failed: ${String(spawnError)}\n`);
    writeAll(logFd, text);
    process.stdout.write(text);
  }
  fs.fsyncSync(logFd);
  fs.closeSync(logFd);

  let commandExitCode = settled.code;
  let signal = settled.signal || forwardedSignal;
  let result;
  let status;
  if (spawnError) {
    commandExitCode = null;
    signal = null;
    status = 127;
    result = "launch-failed";
  } else if (signal) {
    status = 128 + (signalNumbers[signal] || 0);
    result = "signaled";
  } else {
    status = commandExitCode ?? 1;
    result = status === 0 ? "success" : "failure";
  }
  const finishedMs = Date.now();
  atomicJson(
    outcomePath,
    {
      schemaVersion: ARTIFACT_SCHEMA_VERSION,
      jobId: args.jobId,
      terminalId,
      ownerThreadId: args.ownerThreadId,
      commandExitCode,
      signal,
      status,
      result,
      startedAt,
      finishedAt: new Date(finishedMs).toISOString(),
      durationMs: finishedMs - startedMs,
      logPath,
    },
    outcomeFields,
  );
  process.exitCode = status;
}

main().catch((error) => {
  process.stderr.write(`terminal-job-runner: ${error instanceof Error ? error.message : String(error)}\n`);
  process.exitCode = 70;
});
