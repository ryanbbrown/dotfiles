#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: sync-bb-personal [--repo PATH]

Bring the personal branch of the bb checkout up to date with upstream main.

The command fetches upstream, advances local main with fast-forward-only
semantics, merges main into personal inside a temporary worktree, runs the
affected package checks there, and adopts the tested merge into the real
personal checkout with a fast-forward merge. It never pushes.

Git and rerere resolve what they can. Textual conflicts launch Codex for
resolution and validation. A clean merge runs its checks without an agent; if
they fail, Codex gets the failed output and repairs the merge in the same
scratch worktree. This command confirms every recovered result independently
before adoption. A run that does not finish leaves the rerere cache exactly as
it found it.

Options:
  --repo PATH  Git repository that holds the main and personal branches.
               Defaults to ~/code/bb.
  -h, --help   Show this help.
USAGE
}

die() {
  echo "error: $*" >&2
  exit 1
}

repo="$HOME/code/bb"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo)
      [ "$#" -ge 2 ] || die "--repo requires a value"
      repo="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

upstream_remote="upstream"
main_branch="main"
personal_branch="personal"
# The complete repository graph. Codex runs it once after focused checks pass,
# and this script runs it again afterwards to confirm.
check_command='pnpm install --frozen-lockfile --prefer-offline && pnpm exec turbo run typecheck test'
known_flaky_test_path='apps/app/src/components/promptbox/PromptBoxInternal.test.tsx'
known_flaky_test_suite='PromptBoxInternal selection reveal'
known_flaky_test_name='reveals the moving selection head, not the anchor, when a selection extends upward'

git_repo() {
  git -C "$repo" "$@"
}

# rerere records and replays resolutions in the shared rr-cache of the
# repository, so the settings belong on the merge commands rather than in
# anyone's global configuration.
git_merge_tree() {
  git -C "$merge_tree" -c rerere.enabled=true -c rerere.autoupdate=true "$@"
}

worktree_for_branch() {
  local want="branch refs/heads/$1"
  local current=""
  local line
  while IFS= read -r line; do
    if [ "${line#worktree }" != "$line" ]; then
      current="${line#worktree }"
    elif [ "$line" = "$want" ]; then
      printf '%s\n' "$current"
      return 0
    fi
  done < <(git_repo worktree list --porcelain)
  return 1
}

worktree_is_clean() {
  [ -z "$(git -C "$1" status --porcelain)" ]
}

unmerged_paths() {
  git -C "$merge_tree" diff --name-only --diff-filter=U
}

merge_changed_paths() {
  git -C "$merge_tree" diff --name-only -z "$@"
}

# Every file the merge touched is checked, including the ones the resolver
# reached for on its own.
files_with_conflict_markers() {
  local path
  while IFS= read -r -d '' path; do
    [ -f "$merge_tree/$path" ] || continue
    if grep -qIE '^<<<<<<< ' "$merge_tree/$path" &&
      grep -qIE '^>>>>>>> ' "$merge_tree/$path"; then
      printf '%s\n' "$path"
    fi
  done < <(merge_changed_paths "$personal_head")
}

indent() {
  printf '%s\n' "$1" | sed 's/^/  /'
}

run_checks() {
  ( cd "$merge_tree" && sh -c "$check_command" )
}

run_checks_logged() {
  local log="$1" command_status tee_status
  local -a statuses
  set +e
  run_checks 2>&1 | tee "$log"
  statuses=("${PIPESTATUS[@]}")
  set -e
  command_status="${statuses[0]}"
  tee_status="${statuses[1]}"
  [ "$tee_status" -eq 0 ] || return "$tee_status"
  return "$command_status"
}

known_flaky_test_has_upstream_order() {
  local source="$merge_tree/$known_flaky_test_path"
  local section="$temp_root/known-flaky-test-source.txt"
  local start end focus frame spy wait
  [ -f "$source" ] || return 1

  start="$(grep -nFx 'describe("PromptBoxInternal selection reveal", () => {' "$source" | cut -d: -f1)"
  [ -n "$start" ] && [ "${start//$'\n'/}" = "$start" ] || return 1
  end="$(awk -v start="$start" 'NR > start && /^describe\("/ { print NR; exit }' "$source")"
  [ -n "$end" ] || return 1
  sed -n "${start},${end}p" "$source" > "$section"

  [ "$(grep -cFx '  it("reveals the moving selection head, not the anchor, when a selection extends upward", async () => {' "$section" || true)" -eq 1 ] || return 1
  [ "$(grep -cF 'await focusPromptEnd(promptBoxRef);' "$section" || true)" -eq 1 ] || return 1
  [ "$(grep -cF 'await nextAnimationFrame();' "$section" || true)" -eq 2 ] || return 1
  [ "$(grep -cF '.spyOn(EditorView.prototype, "coordsAtPos")' "$section" || true)" -eq 1 ] || return 1
  [ "$(grep -cF 'await waitFor(() => expect(view).not.toBeNull());' "$section" || true)" -eq 1 ] || return 1

  focus="$(grep -nF 'await focusPromptEnd(promptBoxRef);' "$section" | cut -d: -f1)"
  frame="$(grep -nF 'await nextAnimationFrame();' "$section" | head -n 1 | cut -d: -f1)"
  spy="$(grep -nF '.spyOn(EditorView.prototype, "coordsAtPos")' "$section" | cut -d: -f1)"
  wait="$(grep -nF 'await waitFor(() => expect(view).not.toBeNull());' "$section" | cut -d: -f1)"
  [ "$focus" -lt "$frame" ] && [ "$frame" -lt "$spy" ] && [ "$spy" -lt "$wait" ]
}

known_flaky_test_is_sole_failure() {
  local log="$1" clean_log="$temp_root/known-flaky-test-output.txt"
  local failure_identity
  known_flaky_test_has_upstream_order || return 1
  failure_identity="${known_flaky_test_path#apps/app/} > $known_flaky_test_suite > $known_flaky_test_name"
  sed -E $'s/\033\\[[0-9;?]*[ -\\/]*[@-~]//g' "$log" > "$clean_log"

  [ "$(grep -cF "$failure_identity" "$clean_log" || true)" -eq 1 ] || return 1
  [ "$(grep -cF 'AssertionError: expected null not to be null' "$clean_log" || true)" -eq 1 ] || return 1
  [ "$(grep -cE 'Failed Tests[[:space:]]+1([[:space:]]|$)' "$clean_log" || true)" -eq 1 ] || return 1
  [ "$(grep -cE 'Test Files[[:space:]]+1 failed([[:space:]]|$)' "$clean_log" || true)" -eq 1 ] || return 1
  [ "$(grep -cE 'Tests[[:space:]]+1 failed([[:space:]]|$)' "$clean_log" || true)" -eq 1 ] || return 1
  [ "$(grep -cE '^[[:space:]]*Failed:[[:space:]]+@bb/app#test[[:space:]]*$' "$clean_log" || true)" -eq 1 ]
}

retry_known_flaky_test_logged() {
  local log="$1" command_status tee_status
  local -a statuses
  printf '\nRetrying the sole known flaky test once.\n' | tee -a "$log"
  set +e
  ( cd "$merge_tree/apps/app" &&
    pnpm exec vitest run \
      --config vitest.config.ts \
      "${known_flaky_test_path#apps/app/}" \
      --testNamePattern "^$known_flaky_test_suite $known_flaky_test_name\$" ) \
    2>&1 | tee -a "$log"
  statuses=("${PIPESTATUS[@]}")
  set -e
  command_status="${statuses[0]}"
  tee_status="${statuses[1]}"
  [ "$tee_status" -eq 0 ] || return "$tee_status"
  return "$command_status"
}

run_checks_with_known_retry() {
  local log="$1" check_status retry_status
  set +e
  run_checks_logged "$log"
  check_status=$?
  set -e
  [ "$check_status" -ne 0 ] || return 0
  known_flaky_test_is_sole_failure "$log" || return "$check_status"

  echo "The sole failure is the known flaky PromptBox selection-reveal test."
  set +e
  retry_known_flaky_test_logged "$log"
  retry_status=$?
  set -e
  if [ "$retry_status" -eq 0 ]; then
    echo "The known flaky test passed on its one retry."
    return 0
  fi
  echo "The known flaky test failed its one retry." >&2
  return "$retry_status"
}

write_check_runner() {
  check_runner="$temp_root/run-logged-check"
  check_log_dir="$temp_root/check-logs"
  mkdir -p "$check_log_dir"
  cat > "$check_runner" <<'RUNNER'
#!/usr/bin/env bash
set -uo pipefail

if [ "$#" -lt 2 ]; then
  echo "usage: run-logged-check LABEL COMMAND [ARG ...]" >&2
  exit 64
fi
label="$1"
shift
safe_label="$(printf '%s' "$label" | tr -cs 'A-Za-z0-9._-' '-')"
sequence_file="$CHECK_LOG_DIR/.sequence"
sequence=0
[ ! -f "$sequence_file" ] || sequence="$(cat "$sequence_file")"
sequence=$((sequence + 1))
printf '%s\n' "$sequence" > "$sequence_file"
log="$CHECK_LOG_DIR/$(printf '%02d' "$sequence")-$safe_label.log"

if [ "$label" = "complete-repository-graph" ]; then
  if [ -e "$CHECK_LOG_DIR/.complete-repository-graph-started" ]; then
    echo "the nested complete repository graph may run only once" >&2
    exit 65
  fi
  : > "$CHECK_LOG_DIR/.complete-repository-graph-started"
  printf 'SYNC_BB_PERSONAL_FULL_CHECK_BEGIN\n'
fi

set +e
"$@" > "$log" 2>&1
status=$?
set -e

if [ "$status" -eq 0 ]; then
  printf 'PASS: %s (full log: %s)\n' "$label" "$log"
  exit 0
fi

printf 'FAIL: %s (exit %s)\n' "$label" "$status" >&2
printf 'Failed-task summary (full log: %s):\n' "$log" >&2
summary="$(grep -E '(^|[[:space:]])(FAIL|FAILED|ERROR|Error:|Tasks:|Failed:|ELIFECYCLE|Command failed)' "$log" | tail -n 20 || true)"
if [ -n "$summary" ]; then
  printf '%s\n' "$summary" >&2
else
  tail -n 20 "$log" >&2
fi
exit "$status"
RUNNER
  chmod +x "$check_runner"
}

# Break the push URL of every remote and switch rerere off, through the
# environment. No git the resolver runs can publish, and no resolution is
# cached until this script has verified it. Repository configuration is
# untouched and nothing depends on a tool allowlist holding.
build_resolver_env() {
  local remote count=0
  resolver_env=()
  while IFS= read -r remote; do
    resolver_env+=("GIT_CONFIG_KEY_$count=remote.$remote.pushurl")
    resolver_env+=("GIT_CONFIG_VALUE_$count=/dev/null")
    count=$((count + 1))
  done < <(git_repo remote)
  resolver_env+=("GIT_CONFIG_KEY_$count=rerere.enabled")
  resolver_env+=("GIT_CONFIG_VALUE_$count=false")
  count=$((count + 1))
  resolver_env+=("GIT_CONFIG_COUNT=$count")
}

prepare_merge_context() {
  merge_base="$(git_repo merge-base "$personal_head" "$main_branch")"
  incoming_log="$(git_repo log --oneline --no-decorate --max-count=60 "$merge_base..$main_branch")"
  local_log="$(git_repo log --oneline --no-decorate --max-count=60 "$merge_base..$personal_head")"
}

run_codex() {
  local prompt="$1" codex_bin resolver_status
  codex_bin="$(command -v codex)" || die "Codex CLI is not installed"
  build_resolver_env

  ( cd "$merge_tree" && exec env "${resolver_env[@]}" \
      CHECK_LOG_DIR="$check_log_dir" \
      FAILED_CHECK_LOG="${failed_check_log:-}" \
      "$codex_bin" exec \
      --dangerously-bypass-approvals-and-sandbox \
      --ignore-rules \
      --ephemeral \
      "$prompt" ) &
  resolver_pid=$!
  set +e
  wait "$resolver_pid"
  resolver_status=$?
  set -e
  resolver_pid=""
  return "$resolver_status"
}

# A failed attempt must leave the reuse cache exactly as it was, so a
# resolution this run could not verify can never be replayed silently.
snapshot_rr_cache() {
  rr_snapshot="$temp_root/rr-cache.before"
  : > "$rr_snapshot"
  [ -d "$rr_cache_dir" ] || return 0
  ( cd "$rr_cache_dir" && find . -mindepth 1 -maxdepth 2 ) | sort > "$rr_snapshot"
}

restore_rr_cache() {
  local entry
  [ -n "${rr_snapshot:-}" ] && [ -f "$rr_snapshot" ] || return 0
  [ -d "$rr_cache_dir" ] || return 0
  # Reverse order removes a recorded resolution before its directory.
  ( cd "$rr_cache_dir" && find . -mindepth 1 -maxdepth 2 ) | sort -r | while IFS= read -r entry; do
    grep -qxF "$entry" "$rr_snapshot" || rm -rf -- "$rr_cache_dir/$entry"
  done
}

[ -d "$repo" ] || die "repository directory does not exist: $repo"
git_repo rev-parse --git-dir >/dev/null 2>&1 || die "not a Git repository: $repo"
git_repo remote get-url "$upstream_remote" >/dev/null 2>&1 ||
  die "the '$upstream_remote' remote is not configured in $repo"
git_repo rev-parse --verify --quiet "refs/heads/$main_branch" >/dev/null ||
  die "branch $main_branch does not exist in $repo"
git_repo rev-parse --verify --quiet "refs/heads/$personal_branch" >/dev/null ||
  die "branch $personal_branch does not exist in $repo"

# Preflight the real personal checkout before anything else touches the
# repository. A dirty checkout is an editing session, not a sync target.
personal_worktree="$(worktree_for_branch "$personal_branch")" ||
  die "branch $personal_branch is not checked out in any worktree of $repo"
[ -d "$personal_worktree" ] || die "the $personal_branch worktree is missing: $personal_worktree"
worktree_is_clean "$personal_worktree" ||
  die "the $personal_branch checkout has local changes: $personal_worktree"
personal_head="$(git_repo rev-parse "$personal_branch")"

git_repo fetch --quiet "$upstream_remote" "$main_branch" ||
  die "could not fetch $main_branch from $upstream_remote"

main_worktree=""
main_worktree="$(worktree_for_branch "$main_branch")" || true
if [ "$(git_repo rev-parse "$main_branch")" = "$(git_repo rev-parse "$upstream_remote/$main_branch")" ]; then
  echo "Branch $main_branch already matches $upstream_remote/$main_branch."
elif [ -n "$main_worktree" ]; then
  [ -d "$main_worktree" ] || die "the $main_branch worktree is missing: $main_worktree"
  worktree_is_clean "$main_worktree" ||
    die "the $main_branch checkout has local changes and is behind $upstream_remote/$main_branch: $main_worktree"
  git -C "$main_worktree" merge --ff-only "$upstream_remote/$main_branch" >/dev/null ||
    die "$main_branch has diverged from $upstream_remote/$main_branch; resolve it by hand"
  echo "Advanced $main_branch in $main_worktree."
else
  git_repo fetch --quiet "$upstream_remote" "$main_branch:$main_branch" ||
    die "$main_branch has diverged from $upstream_remote/$main_branch; resolve it by hand"
  echo "Advanced $main_branch."
fi

if git_repo merge-base --is-ancestor "$main_branch" "$personal_branch"; then
  echo "Branch $personal_branch already contains $main_branch. Nothing to do."
  exit 0
fi

temp_root="$(mktemp -d "${TMPDIR:-/tmp}/sync-bb-personal.XXXXXX")"
merge_tree="$temp_root/merge"
rr_cache_dir="$(git_repo rev-parse --path-format=absolute --git-common-dir)/rr-cache"
sync_succeeded=0
resolver_pid=""
cleanup() {
  if [ -n "$resolver_pid" ] && kill -0 "$resolver_pid" >/dev/null 2>&1; then
    kill -TERM "$resolver_pid" >/dev/null 2>&1 || true
    wait "$resolver_pid" >/dev/null 2>&1 || true
  fi
  [ "$sync_succeeded" -eq 1 ] || restore_rr_cache
  if [ -d "$merge_tree" ]; then
    git_repo worktree remove --force "$merge_tree" >/dev/null 2>&1 || true
  fi
  rm -rf -- "$temp_root"
  git_repo worktree prune >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
snapshot_rr_cache

git_repo worktree add --quiet --detach "$merge_tree" "$personal_head"
write_check_runner
automatic_merge=0
failed_check_log=""

if git_merge_tree merge --no-ff --no-edit "$main_branch" >/dev/null; then
  automatic_merge=1
  echo "Merged $main_branch into $personal_branch without conflicts."
else
  remaining="$(unmerged_paths)"
  if [ -n "$remaining" ]; then
    echo "Handing the merge to Codex. Conflicted paths:"
    indent "$remaining"

    prepare_merge_context
    prompt="You own a Git merge from start to finish, inside an isolated scratch worktree. Your working directory is that worktree. It is disposable and it is safe to change anything in it.

The merge brings branch $main_branch into branch $personal_branch.

Merge base:              $merge_base
Incoming ($main_branch): $(git_repo rev-parse "$main_branch")
Local ($personal_branch): $personal_head

Git could not resolve these paths:
$remaining

Incoming commits since the merge base:
$incoming_log

Local commits since the merge base:
$local_log

The complete repository graph is:

    $check_command

Use this log wrapper for every install, typecheck, and test command. It prints a
short failed-task summary first and keeps the full output at the path it reports:

    $check_runner LABEL COMMAND [ARG ...]

CHECK_LOG_DIR is already set to:

    $check_log_dir

Work through it in this order:
1. Resolve every conflicted path. Each one keeps its three inputs in the index: 'git show :1:<path>' is the merge base, ':2:<path>' is $personal_branch, ':3:<path>' is $main_branch. Use git log and git diff over the ranges above to find out why each side changed, and decide from that evidence rather than from the conflict markers alone.
2. Read the repository's own instructions and package scripts. Install dependencies through the log wrapper.
3. Before tests, typecheck the packages changed since $merge_base and their dependants. Use the repository's task runner and package graph to select them; do not typecheck the complete graph at this stage. Fix all real type errors and repeat this focused typecheck until it passes.
4. Run focused tests for the changed packages and for actual failures that your resolutions can affect. Repeat only the failed task or smallest relevant test while diagnosing it. Make these focused checks pass before the complete graph.
5. A clean textual merge is not enough. Check files that merged cleanly but no longer agree with the resolutions. AUTO_MERGE is available for comparing your resolution work with Git's automatic merge.
6. If a failure is in code outside 'git diff --name-only AUTO_MERGE', reproduce that exact failing task once by itself under stable load before editing code. If the isolated rerun passes, treat it as a one-off timeout and do not make an unrelated speculative fix. If it fails again, diagnose it from evidence.
7. Only after the changed-package typecheck and focused tests pass, run the nested complete repository graph with this exact wrapper label:

    $check_runner complete-repository-graph sh -c '$check_command'

The wrapper permits this graph once. If it fails, apply the isolated-rerun rule above, make evidence-based repairs, and repeat the smallest relevant checks. Leave the second complete graph to the outer script. Keep working until the focused checks pass, or until you reach something you genuinely cannot fix.

You may run any command you need. Rules:
- Keep the intent of both sides. Do not drop $personal_branch customizations and do not drop upstream changes.
- Do not weaken a check to make it pass. Do not delete or skip a test, and do not silence a type error, unless the merge genuinely made it obsolete and you say so.
- Do not commit and do not push. Everything you leave in the worktree is committed for you.
- Run the nested complete repository graph exactly once and only after focused checks pass.

Finish by stating the nested complete graph result and any focused repairs made after it. If focused checks still fail, say exactly what blocked you."

    run_codex "$prompt" ||
      die "Codex did not finish; $personal_branch is unchanged"

    still_unmerged="$(unmerged_paths)"
    if [ -n "$still_unmerged" ]; then
      echo "Git still reports these paths as unresolved:" >&2
      indent "$still_unmerged" >&2
      die "stopped without changing $personal_branch"
    fi
    marked="$(files_with_conflict_markers)"
    if [ -n "$marked" ]; then
      echo "These files still contain conflict markers:" >&2
      indent "$marked" >&2
      die "stopped without changing $personal_branch"
    fi
  fi

  git -C "$merge_tree" rev-parse --verify --quiet MERGE_HEAD >/dev/null ||
    die "the merge state was lost; $personal_branch is unchanged"
  # The resolver edits more than the conflicted files, so the commit has to
  # carry everything it left behind.
  git -C "$merge_tree" add -A
  git_merge_tree commit --no-edit >/dev/null ||
    die "could not record the merge commit; $personal_branch is unchanged"
  echo "Merged $main_branch into $personal_branch after conflict resolution."
fi

merge_commit="$(git -C "$merge_tree" rev-parse HEAD)"
[ "$(git -C "$merge_tree" rev-parse "$merge_commit^1")" = "$personal_head" ] ||
  die "the merge commit does not build on $personal_branch; nothing was adopted"

# A clean textual merge gets one agent-free check. Codex joins only when that
# check fails, and it repairs the existing merge inside the same worktree.
echo "Confirming the repository checks."
failed_check_log="$check_log_dir/automatic-merge-check.log"
if run_checks_with_known_retry "$failed_check_log"; then
  :
elif [ "$automatic_merge" -eq 1 ]; then
  echo "The automatic merge failed its checks. Handing the same worktree to Codex."
  prepare_merge_context
  failed_check_output="$(tail -n 80 "$failed_check_log")"
  prompt="You own recovery of a Git merge inside an isolated scratch worktree. Your working directory is that worktree. It is disposable and it is safe to change anything in it.

The merge brings branch $main_branch into branch $personal_branch. Git merged without textual conflicts, but the complete repository checks failed.

Merge base:              $merge_base
Incoming ($main_branch): $(git_repo rev-parse "$main_branch")
Local ($personal_branch): $personal_head
Automatic merge commit:  $merge_commit

Incoming commits since the merge base:
$incoming_log

Local commits since the merge base:
$local_log

The failed check was:

    $check_command

Its full output is available at:

    $failed_check_log

The last 80 lines are:

$failed_check_output

The complete repository graph is:

    $check_command

Use this log wrapper for every install, typecheck, and test command. It prints a
short failed-task summary first and keeps the full output at the path it reports:

    $check_runner LABEL COMMAND [ARG ...]

CHECK_LOG_DIR is already set to:

    $check_log_dir

Work through it in this order:
1. Read the failed check log and diagnose how the merge made the two branches disagree.
2. Read the repository's own instructions and package scripts. Use Git history and diffs over the ranges above to preserve the intent of both sides.
3. Before tests, typecheck the packages changed since $merge_base and their dependants. Use the repository's task runner and package graph to select them; do not typecheck the complete graph at this stage. Fix all real type errors and repeat this focused typecheck until it passes.
4. Run focused tests for the changed packages and for actual failures that your repairs can affect. Repeat only the failed task or smallest relevant test while diagnosing it. Make these focused checks pass before the complete graph.
5. If a failure is outside the merge diff, reproduce that exact failing task once by itself under stable load before editing code. If the isolated rerun passes, treat it as a one-off timeout and do not make an unrelated speculative fix.
6. Only after the changed-package typecheck and focused tests pass, run the nested complete repository graph with this exact wrapper label:

    $check_runner complete-repository-graph sh -c '$check_command'

The wrapper permits this graph once. If it fails, make evidence-based repairs and repeat the smallest relevant checks. Leave the final complete graph to the outer script. Keep working until the focused checks pass, or until you reach something you genuinely cannot fix.

You may run any command you need. Rules:
- Keep the intent of both sides. Do not drop $personal_branch customizations and do not drop upstream changes.
- Do not weaken a check to make it pass. Do not delete or skip a test, and do not silence a type error, unless the merge genuinely made it obsolete and you say so.
- Do not commit and do not push. Everything you leave in the worktree is committed for you.
- Run the nested complete repository graph exactly once and only after focused checks pass.

Finish by stating the nested complete graph result and the repairs you made. If focused checks still fail, say exactly what blocked you."

  run_codex "$prompt" ||
    die "Codex did not finish after the failed checks; $personal_branch is unchanged"
  [ "$(git -C "$merge_tree" rev-parse HEAD)" = "$merge_commit" ] ||
    die "Codex changed the merge history; $personal_branch is unchanged"
  marked="$(files_with_conflict_markers)"
  if [ -n "$marked" ]; then
    echo "These files contain conflict markers after check recovery:" >&2
    indent "$marked" >&2
    die "stopped without changing $personal_branch"
  fi
  git -C "$merge_tree" add -A
  git_merge_tree commit --amend --no-edit >/dev/null ||
    die "could not record the check repairs; $personal_branch is unchanged"
  merge_commit="$(git -C "$merge_tree" rev-parse HEAD)"
  [ "$(git -C "$merge_tree" rev-parse "$merge_commit^1")" = "$personal_head" ] ||
    die "the repaired merge does not build on $personal_branch; nothing was adopted"

  echo "Confirming the repository checks after Codex recovery."
  failed_check_log="$check_log_dir/recovered-merge-check.log"
  run_checks_with_known_retry "$failed_check_log" ||
    die "checks still fail after Codex recovery; $personal_branch is unchanged"
else
  die "checks failed; $personal_branch is unchanged"
fi

# The real checkout is live. Adopt only if it is still exactly where the merge
# started, and only by fast-forward, so a half-updated tree cannot happen.
[ "$(git_repo rev-parse "$personal_branch")" = "$personal_head" ] ||
  die "$personal_branch moved during the sync; nothing was adopted"
worktree_is_clean "$personal_worktree" ||
  die "the $personal_branch checkout changed during the sync; nothing was adopted"
git -C "$personal_worktree" merge --ff-only "$merge_commit" >/dev/null ||
  die "could not fast-forward $personal_branch; nothing was adopted"

sync_succeeded=1
echo "Adopted $(git_repo rev-parse --short "$merge_commit") into $personal_branch at $personal_worktree."
echo "Nothing was pushed."
