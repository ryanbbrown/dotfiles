#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: sync-bb-personal [--repo PATH]

Bring the personal branch of the bb checkout up to date with upstream main.

The command fetches upstream, advances local main with fast-forward-only
semantics, merges main into personal inside a temporary worktree, runs the
affected package checks there, and adopts the tested merge into the real
personal checkout with a fast-forward merge. It never pushes.

Git and rerere resolve what they can. Claude Code receives whatever conflicts
remain, with the history of both sides, and resolves them at high effort. The
command rejects the merge if any conflict survives.

Options:
  --repo PATH  Git repository that holds the main and personal branches.
               Defaults to ~/code/bb.
  -h, --help   Show this help.
USAGE
}

die() {
  echo "error: $*" >&2
  exit 1
}

repo="$HOME/code/bb"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo)
      [ "$#" -ge 2 ] || die "--repo requires a value"
      repo="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

upstream_remote="upstream"
main_branch="main"
personal_branch="personal"

git_repo() {
  git -C "$repo" "$@"
}

# rerere records and replays resolutions in the shared rr-cache of the
# repository, so the settings belong on the merge commands rather than in
# anyone's global configuration.
git_merge_tree() {
  git -C "$merge_tree" -c rerere.enabled=true -c rerere.autoupdate=true "$@"
}

worktree_for_branch() {
  local want="branch refs/heads/$1"
  local current=""
  local line
  while IFS= read -r line; do
    if [ "${line#worktree }" != "$line" ]; then
      current="${line#worktree }"
    elif [ "$line" = "$want" ]; then
      printf '%s\n' "$current"
      return 0
    fi
  done < <(git_repo worktree list --porcelain)
  return 1
}

worktree_is_clean() {
  [ -z "$(git -C "$1" status --porcelain)" ]
}

unmerged_paths() {
  git -C "$merge_tree" diff --name-only --diff-filter=U
}

merge_changed_paths() {
  git -C "$merge_tree" diff --name-only -z "$@"
}

# Every file the merge touched is checked, including the ones the resolver
# reached for on its own.
files_with_conflict_markers() {
  local path
  while IFS= read -r -d '' path; do
    [ -f "$merge_tree/$path" ] || continue
    if grep -qIE '^<<<<<<< ' "$merge_tree/$path" &&
      grep -qIE '^>>>>>>> ' "$merge_tree/$path"; then
      printf '%s\n' "$path"
    fi
  done < <(merge_changed_paths "$personal_head")
}

indent() {
  printf '%s\n' "$1" | sed 's/^/  /'
}

# turbo selects packages by directory, so a change to a root file such as the
# lockfile selects nothing at all. Those runs have to check everything.
merge_changed_files_outside_packages() {
  local path directory
  while IFS= read -r -d '' path; do
    directory="$(dirname "$path")"
    while [ "$directory" != "." ]; do
      if git -C "$merge_tree" cat-file -e "$merge_commit:$directory/package.json" 2>/dev/null; then
        continue 2
      fi
      directory="$(dirname "$directory")"
    done
    return 0
  done < <(merge_changed_paths "$personal_head" "$merge_commit")
  return 1
}

run_checks() {
  ( cd "$merge_tree" &&
    pnpm install --frozen-lockfile --prefer-offline &&
    pnpm exec turbo run typecheck test "$@" )
}

# Break the push URL of every remote through the environment, so no git the
# resolver runs can publish. This leaves the repository configuration alone and
# does not depend on a tool allowlist holding.
build_no_push_env() {
  local remote count=0
  no_push_env=()
  while IFS= read -r remote; do
    no_push_env+=("GIT_CONFIG_KEY_$count=remote.$remote.pushurl")
    no_push_env+=("GIT_CONFIG_VALUE_$count=/dev/null")
    count=$((count + 1))
  done < <(git_repo remote)
  no_push_env+=("GIT_CONFIG_COUNT=$count")
}

[ -d "$repo" ] || die "repository directory does not exist: $repo"
git_repo rev-parse --git-dir >/dev/null 2>&1 || die "not a Git repository: $repo"
git_repo remote get-url "$upstream_remote" >/dev/null 2>&1 ||
  die "the '$upstream_remote' remote is not configured in $repo"
git_repo rev-parse --verify --quiet "refs/heads/$main_branch" >/dev/null ||
  die "branch $main_branch does not exist in $repo"
git_repo rev-parse --verify --quiet "refs/heads/$personal_branch" >/dev/null ||
  die "branch $personal_branch does not exist in $repo"

# Preflight the real personal checkout before anything else touches the
# repository. A dirty checkout is an editing session, not a sync target.
personal_worktree="$(worktree_for_branch "$personal_branch")" ||
  die "branch $personal_branch is not checked out in any worktree of $repo"
[ -d "$personal_worktree" ] || die "the $personal_branch worktree is missing: $personal_worktree"
worktree_is_clean "$personal_worktree" ||
  die "the $personal_branch checkout has local changes: $personal_worktree"
personal_head="$(git_repo rev-parse "$personal_branch")"

git_repo fetch --quiet "$upstream_remote" "$main_branch" ||
  die "could not fetch $main_branch from $upstream_remote"

main_worktree=""
main_worktree="$(worktree_for_branch "$main_branch")" || true
if [ "$(git_repo rev-parse "$main_branch")" = "$(git_repo rev-parse "$upstream_remote/$main_branch")" ]; then
  echo "Branch $main_branch already matches $upstream_remote/$main_branch."
elif [ -n "$main_worktree" ]; then
  [ -d "$main_worktree" ] || die "the $main_branch worktree is missing: $main_worktree"
  worktree_is_clean "$main_worktree" ||
    die "the $main_branch checkout has local changes and is behind $upstream_remote/$main_branch: $main_worktree"
  git -C "$main_worktree" merge --ff-only "$upstream_remote/$main_branch" >/dev/null ||
    die "$main_branch has diverged from $upstream_remote/$main_branch; resolve it by hand"
  echo "Advanced $main_branch in $main_worktree."
else
  git_repo fetch --quiet "$upstream_remote" "$main_branch:$main_branch" ||
    die "$main_branch has diverged from $upstream_remote/$main_branch; resolve it by hand"
  echo "Advanced $main_branch."
fi

if git_repo merge-base --is-ancestor "$main_branch" "$personal_branch"; then
  echo "Branch $personal_branch already contains $main_branch. Nothing to do."
  exit 0
fi

temp_root="$(mktemp -d "${TMPDIR:-/tmp}/sync-bb-personal.XXXXXX")"
merge_tree="$temp_root/merge"
cleanup() {
  if [ -d "$merge_tree" ]; then
    git_repo worktree remove --force "$merge_tree" >/dev/null 2>&1 || true
  fi
  rm -rf -- "$temp_root"
  git_repo worktree prune >/dev/null 2>&1 || true
}
trap cleanup EXIT

git_repo worktree add --quiet --detach "$merge_tree" "$personal_head"

if git_merge_tree merge --no-ff --no-edit "$main_branch" >/dev/null; then
  echo "Merged $main_branch into $personal_branch without conflicts."
else
  remaining="$(unmerged_paths)"
  if [ -n "$remaining" ]; then
    claude_bin="$(command -v claude)" || die "Claude Code is not installed"
    build_no_push_env
    echo "Asking Claude Code to resolve:"
    indent "$remaining"

    merge_base="$(git_repo merge-base "$personal_head" "$main_branch")"
    incoming_log="$(git_repo log --oneline --no-decorate --max-count=60 "$merge_base..$main_branch")"
    local_log="$(git_repo log --oneline --no-decorate --max-count=60 "$merge_base..$personal_head")"

    prompt="You are resolving a Git merge inside an isolated scratch worktree. The merge brings branch $main_branch into branch $personal_branch. Your working directory is the worktree and it is safe to change anything in it.

Merge base:              $merge_base
Incoming ($main_branch): $(git_repo rev-parse "$main_branch")
Local ($personal_branch): $personal_head

Git could not resolve these paths:
$remaining

Incoming commits since the merge base:
$incoming_log

Local commits since the merge base:
$local_log

Every conflicted path keeps its three inputs in the index: 'git show :1:<path>' is the merge base, ':2:<path>' is $personal_branch, ':3:<path>' is $main_branch. Use git log and git diff over the ranges above to find out why each side changed, then decide from that evidence rather than from the conflict markers alone.

Rules:
- Keep the intent of both sides. Do not drop $personal_branch customizations and do not drop upstream changes.
- Resolve every path listed above and leave no conflict markers anywhere in the worktree.
- Make any other change the merge needs to be coherent, in any file.
- Do not commit and do not push. Staging is optional; everything left in the worktree is committed for you.

Reply with one line per path: '<path>: resolved' or '<path>: unresolved'."

    ( cd "$merge_tree" && env "${no_push_env[@]}" "$claude_bin" -p "$prompt" \
        --effort high \
        --permission-mode acceptEdits \
        --allowedTools 'Read,Edit,Write,Grep,Glob,Bash(git *)' ) ||
      die "Claude Code did not finish; $personal_branch is unchanged"

    still_unmerged="$(unmerged_paths)"
    if [ -n "$still_unmerged" ]; then
      echo "Git still reports these paths as unresolved:" >&2
      indent "$still_unmerged" >&2
      die "stopped without changing $personal_branch"
    fi
    marked="$(files_with_conflict_markers)"
    if [ -n "$marked" ]; then
      echo "These files still contain conflict markers:" >&2
      indent "$marked" >&2
      die "stopped without changing $personal_branch"
    fi
  fi

  git -C "$merge_tree" rev-parse --verify --quiet MERGE_HEAD >/dev/null ||
    die "the merge state was lost; $personal_branch is unchanged"
  # The resolver may edit more than the conflicted files, and the checks below
  # read the working tree, so the commit has to carry everything in it.
  git -C "$merge_tree" add -A
  git_merge_tree commit --no-edit >/dev/null ||
    die "could not record the merge commit; $personal_branch is unchanged"
  echo "Merged $main_branch into $personal_branch after conflict resolution."
fi

merge_commit="$(git -C "$merge_tree" rev-parse HEAD)"
[ "$(git -C "$merge_tree" rev-parse "$merge_commit^1")" = "$personal_head" ] ||
  die "the merge commit does not build on $personal_branch; nothing was adopted"

if merge_changed_files_outside_packages; then
  echo "The merge changes files outside the workspace packages. Checking everything."
  run_checks || die "checks failed; $personal_branch is unchanged"
else
  echo "Running checks for the packages the merge changed."
  # turbo selects the changed packages and their dependents from the range, so
  # the run stays as small as the merge allows.
  run_checks --filter="...[$personal_head]" || die "checks failed; $personal_branch is unchanged"
fi

# The real checkout is live. Adopt only if it is still exactly where the merge
# started, and only by fast-forward, so a half-updated tree cannot happen.
[ "$(git_repo rev-parse "$personal_branch")" = "$personal_head" ] ||
  die "$personal_branch moved during the sync; nothing was adopted"
worktree_is_clean "$personal_worktree" ||
  die "the $personal_branch checkout changed during the sync; nothing was adopted"
git -C "$personal_worktree" merge --ff-only "$merge_commit" >/dev/null ||
  die "could not fast-forward $personal_branch; nothing was adopted"

echo "Adopted $(git_repo rev-parse --short "$merge_commit") into $personal_branch at $personal_worktree."
echo "Nothing was pushed."
