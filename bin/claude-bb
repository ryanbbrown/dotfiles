#!/usr/bin/env python3
# Claude Code wrapper for BB (set BB_CLAUDE_CODE_EXECUTABLE to this file).
# BB asks for a "full" context breakdown after every turn, which opens ~30 token-count
# connections and exhausts Cloud NAT ports; this rewrites the request to "summary".
import os
import signal
import subprocess
import sys
import threading

REAL = os.environ.get("CLAUDE_REAL_EXECUTABLE", os.path.expanduser("~/.local/bin/claude"))
FULL = b'"subtype":"get_context_usage"'
SUMMARY = b'"subtype":"get_context_usage","detail":"summary"'

# close_fds=False keeps descriptors the SDK may pass, such as an OAuth token descriptor.
child = subprocess.Popen([REAL, *sys.argv[1:]], stdin=subprocess.PIPE, close_fds=False)
for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(sig, lambda n, _f: child.send_signal(n))


def pump():
    try:
        for line in sys.stdin.buffer:
            if FULL in line and b'"detail"' not in line:
                line = line.replace(FULL, SUMMARY, 1)
            child.stdin.write(line)
            child.stdin.flush()
    except BrokenPipeError:
        pass
    finally:
        try:
            child.stdin.close()
        except OSError:
            pass


threading.Thread(target=pump, daemon=True).start()
code = child.wait()
if code < 0:
    signal.signal(-code, signal.SIG_DFL)
    os.kill(os.getpid(), -code)
sys.exit(code)
