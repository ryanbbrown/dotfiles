#!/usr/bin/env bash
set -euo pipefail

state="${ROTATE_FIRSTMATE_TEST_STATE:?}"
command_name="${1:-} ${2:-}"
old_id=thr_old
new_id=thr_new
child_a=thr_childa
child_b=thr_childb
child_c=thr_childc

value() {
  sed -n '1p' "$state/$1"
}

set_value() {
  printf '%s\n' "$2" > "$state/$1"
}

pin_file() {
  case "$1" in
    "$old_id") printf '%s\n' old_pinned ;;
    "$new_id") printf '%s\n' new_pinned ;;
    *) return 1 ;;
  esac
}

parent_file() {
  case "$1" in
    "$child_a") printf '%s\n' child_a_parent ;;
    "$child_b") printf '%s\n' child_b_parent ;;
    "$child_c") printf '%s\n' child_c_parent ;;
    *) return 1 ;;
  esac
}

thread_json() {
  local id="$1"
  local title=Worker
  local project=proj_current
  local environment=env_current
  local provider=pi
  local parent=null
  local section=null
  local visibility=visible
  local pinned=false
  local workspace

  workspace="$(value workspace_path)"
  case "$id" in
    "$old_id")
      title="$(value old_title)"
      project="$(value old_project)"
      environment="$(value old_environment)"
      provider="$(value old_provider)"
      parent="$(value old_parent)"
      section="$(value old_section)"
      visibility="$(value old_visibility)"
      pinned="$(value old_pinned)"
      ;;
    "$new_id")
      title="$(value spawn_title)"
      project="$(value spawn_project)"
      environment="$(value spawn_environment)"
      provider="$(value spawn_provider)"
      parent="$(value spawn_parent)"
      section="$(value spawn_section)"
      visibility="$(value spawn_visibility)"
      pinned="$(value new_pinned)"
      ;;
    "$child_a"|"$child_b"|"$child_c")
      parent="$(value "$(parent_file "$id")")"
      [ "$id" = "$child_b" ] && project=proj_other
      ;;
    *) exit 2 ;;
  esac

  jq -cn \
    --arg id "$id" \
    --arg title "$title" \
    --arg project "$project" \
    --arg environment "$environment" \
    --arg provider "$provider" \
    --arg parent "$parent" \
    --arg section "$section" \
    --arg visibility "$visibility" \
    --argjson pinned "$pinned" \
    --arg workspace "$workspace" '
      {
        thread: {
          id: $id,
          title: $title,
          projectId: $project,
          environmentId: $environment,
          providerId: $provider,
          parentThreadId: (if $parent == "null" then null else $parent end),
          sectionId: (if $section == "null" then null else $section end),
          visibility: $visibility,
          pinnedAt: (if $pinned then 100 else null end),
          status: "idle"
        },
        environment: {path: $workspace}
      }
    '
}

execution_json() {
  local prefix="$1"
  jq -cn \
    --arg model "$(value "${prefix}_model")" \
    --arg reasoning "$(value "${prefix}_reasoning")" \
    --arg permission "$(value "${prefix}_permission")" \
    --arg tier "$(value "${prefix}_tier")" '
      [{type: "client/turn/requested", data: {execution: {
        model: $model,
        reasoningLevel: $reasoning,
        permissionMode: $permission,
        serviceTier: $tier
      }}}]
    '
}

record_spawn() {
  : > "$state/spawn_args"
  set_value spawn_parent null
  set_value spawn_section null
  set_value spawn_visibility visible

  local previous=""
  local arg
  for arg in "$@"; do
    printf '%s\n' "$arg" >> "$state/spawn_args"
    case "$previous" in
      --project) set_value spawn_project "$arg" ;;
      --environment) set_value spawn_environment "$arg" ;;
      --provider) set_value spawn_provider "$arg" ;;
      --model) set_value spawn_model "$arg" ;;
      --reasoning-level) set_value spawn_reasoning "$arg" ;;
      --permission-mode) set_value spawn_permission "$arg" ;;
      --service-tier) set_value spawn_tier "$arg" ;;
      --title) set_value spawn_title "$arg" ;;
      --prompt) set_value spawn_prompt "$arg" ;;
      --send-at) set_value spawn_send_at "$arg" ;;
      --parent-thread) set_value spawn_parent "$arg" ;;
      --section) set_value spawn_section "$arg" ;;
      --visibility) set_value spawn_visibility "$arg" ;;
    esac
    previous="$arg"
  done
  printf 'spawned\n' >> "$state/spawn_calls"
}

case "$command_name" in
  "thread show")
    thread_json "$3"
    ;;
  "thread log")
    if [ "$3" = "$old_id" ]; then
      execution_json old
    elif [ "$3" = "$new_id" ]; then
      execution_json spawn
    else
      exit 2
    fi
    ;;
  "thread spawn")
    record_spawn "$@"
    printf '{"thread":{"id":"%s"}}\n' "$new_id"
    ;;
  "thread wait")
    if [ "$3" = "$new_id" ] && [ ! -s "$state/queue_send_calls" ]; then
      echo "waited for the replacement before sending its first message" >&2
      exit 2
    fi
    printf '{"status":"idle"}\n'
    ;;
  "thread queue")
    case "$3" in
      list)
        [ "$4" = "$new_id" ] || exit 2
        printf '[{"id":"qmsg_first"}]\n'
        ;;
      send)
        { [ "$4" = "$new_id" ] && [ "$5" = qmsg_first ]; } || exit 2
        printf '%s\n' "$4 $5" >> "$state/queue_send_calls"
        printf '{"ok":true}\n'
        ;;
      *) exit 2 ;;
    esac
    ;;
  "plugin config")
    [ "$3" = firstmate-queue ] || exit 2
    case "${4:-}" in
      --json)
        jq -cn --arg manager "$(value manager_thread)" --argjson writes "$(value manager_writes)" '
          {ok: true, values: {managerThreadId: (if $manager == "" then null else $manager end), agentWritesEnabled: $writes}}
        '
        ;;
      set)
        case "$5" in
          managerThreadId) set_value manager_thread "$6" ;;
          agentWritesEnabled) set_value manager_writes "$6" ;;
          *) exit 2 ;;
        esac
        printf '{"ok":true}\n'
        ;;
      unset)
        [ "$5" = managerThreadId ] || exit 2
        set_value manager_thread ""
        printf '{"ok":true}\n'
        ;;
      *) exit 2 ;;
    esac
    ;;
  "thread pin")
    printf '%s\n' "$3" >> "$state/pin_calls"
    set_value "$(pin_file "$3")" true
    printf '{"ok":true}\n'
    ;;
  "thread unpin")
    printf '%s\n' "$3" >> "$state/unpin_calls"
    if [ "$(value mode)" = fail-child-c-replacement-unpin ] && [ "$3" = "$new_id" ]; then
      exit 1
    fi
    set_value "$(pin_file "$3")" false
    printf '{"ok":true}\n'
    ;;
  "thread update")
    child_id="$3"
    shift 3
    target=""
    while [ "$#" -gt 0 ]; do
      if [ "$1" = --parent-thread ]; then
        target="$2"
        break
      fi
      shift
    done
    if { [ "$(value mode)" = fail-child-c ] || [ "$(value mode)" = fail-child-c-replacement-unpin ]; } &&
      [ "$child_id" = "$child_c" ] && [ "$target" = "$new_id" ]; then
      exit 1
    fi
    if [ "$(value mode)" = fail-child-c-rollback-a ]; then
      if [ "$child_id" = "$child_c" ] && [ "$target" = "$new_id" ]; then
        exit 1
      fi
      if [ "$child_id" = "$child_a" ] && [ "$target" = "$old_id" ]; then
        exit 1
      fi
    fi
    set_value "$(parent_file "$child_id")" "$target"
    printf '{"ok":true}\n'
    ;;
  "thread list")
    shift 2
    parent=""
    archived=false
    include_hidden=false
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --parent-thread)
          parent="$2"
          shift 2
          ;;
        --archived)
          archived=true
          shift
          ;;
        --include-hidden)
          include_hidden=true
          shift
          ;;
        --project)
          echo "child discovery must not use a project filter" >&2
          exit 2
          ;;
        *) shift ;;
      esac
    done
    [ "$include_hidden" = true ] || {
      echo "child discovery must include hidden threads" >&2
      exit 2
    }
    if [ "$archived" = true ]; then
      jq -cn \
        --arg id "$child_b" \
        --arg child_parent "$(value child_b_parent)" \
        --arg parent "$parent" \
        '[{id: $id, archivedAt: 100, parent: $child_parent}] | map(select(.parent == $parent) | del(.parent))'
    else
      jq -cn \
        --arg child_a "$child_a" \
        --arg child_b "$child_b" \
        --arg child_c "$child_c" \
        --arg parent_a "$(value child_a_parent)" \
        --arg parent_b "$(value child_b_parent)" \
        --arg parent_c "$(value child_c_parent)" \
        --arg parent "$parent" '
          [
            {id: $child_a, archivedAt: null, parent: $parent_a},
            {id: $child_b, archivedAt: 100, parent: $parent_b},
            {id: $child_c, archivedAt: null, parent: $parent_c}
          ] | map(select(.parent == $parent) | del(.parent))
        '
    fi
    ;;
  *)
    echo "unexpected bb command: $*" >&2
    exit 2
    ;;
esac
