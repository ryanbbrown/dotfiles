{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm test*)",
      "Bash(npx playwright test*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(tmux:*)",
      "Read(//**)",
      "Skill",
      "Read",
      "Glob",
      "Search",
      "WebSearch",
      "WebFetch",
      "Grep"
    ],
    "deny": [
      "mcp__plugin_readwise_readwise__*",
      "mcp__readwise__*"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ryanbrown/.local/bin/dcg"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'msg=$(jq -r \".last_assistant_message // empty\" | tr -d \"\\000-\\037\" | cut -c1-140); [ -n \"$CMUX_SURFACE_ID\" ] && [ -n \"$msg\" ] && \"${CMUX_BUNDLED_CLI_PATH:-cmux}\" notify --surface \"$CMUX_SURFACE_ID\" --title \"Claude Code\" --body \"$msg\" >/dev/null 2>&1 || true'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && \"${CMUX_BUNDLED_CLI_PATH:-cmux}\" set-status agentrun Idle --icon moon.fill --color \"#8E8E93\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cli=\"${CMUX_BUNDLED_CLI_PATH:-cmux}\"; [ -n \"$CMUX_SURFACE_ID\" ] || exit 0; \"$cli\" notify --surface \"$CMUX_SURFACE_ID\" --title \"Claude Code\" --body \"needs your approval\" >/dev/null 2>&1; true'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -n \"$CMUX_SURFACE_ID\" ] && \"${CMUX_BUNDLED_CLI_PATH:-cmux}\" set-status agentrun Idle --icon moon.fill --color \"#8E8E93\" >/dev/null 2>&1 || true'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && \"${CMUX_BUNDLED_CLI_PATH:-cmux}\" set-status agentrun Idle --icon moon.fill --color \"#8E8E93\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cmux-session.sh session-end"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cmux-session.sh prompt-submit"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline.sh"
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "swiftui-expert@swiftui-expert-skill": true,
    "swift-lsp@claude-plugins-official": true,
    "readwise@readwise-skills": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "readwise-skills": {
      "source": {
        "source": "github",
        "repo": "readwiseio/readwise-skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    }
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "npmjs.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "*.pypi.org",
        "files.pythonhosted.org",
        "*.pythonhosted.org"
      ]
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "terminal_bell"
}
